# Vercel server-only values. Copy to .env.local for development; never commit it.
# Public browsing works without these. Account/community/AI features require setup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
# 64 hexadecimal characters; generate once and retain across deployments.
AI_KEYS_ENCRYPTION_KEY=
# Optional: distinct namespace when sharing a database with another project.
CAREER_COMPASS_STORAGE_PREFIX=
# Optional: at least 32 random characters if enabling an opportunity refresh cron.
CRON_SECRET=
# Sites-only: not used or trusted by the independent Vercel adapter.
OWNER_EMAIL=
